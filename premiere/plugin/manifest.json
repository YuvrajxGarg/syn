{
  "manifestVersion": 5,
  "id": "in.pxlvzn.syn",
  "name": "Syn",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "syn.panel",
      "label": {
        "default": "SYN"
      },
      "minimumSize": {
        "width": 240,
        "height": 320
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 560
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "http://127.0.0.1:47480",
        "http://127.0.0.1:47481",
        "http://127.0.0.1:47482",
        "http://127.0.0.1:47483",
        "http://127.0.0.1:47484",
        "http://127.0.0.1:47485",
        "http://127.0.0.1:47486",
        "http://127.0.0.1:47487",
        "http://127.0.0.1:47488",
        "http://127.0.0.1:47489"
      ]
    }
  }
}
